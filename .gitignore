#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules (sorted alphabetically)
#
.*
*.a
*.asn1.[ch]
*.bin
*.bz2
*.c.[012]*.*
*.dt.yaml
*.dtb
*.dtb.S
*.dtbo
*.dtbo.img
*.dwo
*.elf
*.gcno
*.gz
*.i
*.ko
*.lex.c
*.ll
*.lst
*.lz4
*.lzma
*.lzo
*.mod
*.mod.c
*.ns_deps
*.o
*.o.*
*.patch
*.s
*.so
*.so.dbg
*.su
*.symtypes
*.tab.[ch]
*.tar
*.xz
Module.symvers
modules.builtin
modules.order

#
# Top-level generic files
#
/tags
/TAGS
/linux
/vmlinux
/vmlinux.32
/vmlinux-gdb.py
/vmlinuz
/System.map
/Module.markers
/modules.builtin.modinfo
/arch/arm64/boot/Image*

#
# Android / Custom build outputs
#
/out/
/toolchain/

#
# RPM / Debian / Snap / Tar packages
#
/*.spec
/debian/
/snap/
/tar-install/

#
# Whitelist dot-files that should be tracked
#
!.clang-format
!.cocciconfig
!.get_maintainer.ignore
!.gitattributes
!.gitignore
!.mailmap

#
# Whitelist Makefiles that match extension patterns (e.g., Makefile.dtbo)
#
!scripts/Makefile.dtbo
!**/Makefile*

#
# Whitelist vendor firmware and prebuilt binary blobs
#
!/firmware/**
!/security/samsung/defex_lsm/*.bin

#
# Generated include files
#
/include/config/
/include/generated/
/include/ksym/
/arch/*/include/generated/

# StGit / Quilt
patches-*
patches
series

# Cscope / GNU Global / ID
cscope.*
ncscope.*
GPATH
GRTAGS
GSYMS
GTAGS
ID

# Editor & Backup files
*~
*.bak
*.orig
*.rej
*.swp
*.swo
\#*#

# OS generated files
.DS_Store
._*
Thumbs.db
desktop.ini

# Module signing leavings
extra_certificates
signing_key.pem
signing_key.priv
signing_key.x509
x509.genkey

# Kconfig presets
/all.config
/alldef.config
/allmod.config
/allno.config
/allrandom.config
/allyes.config

# IDE & Editor configs
/.vscode/
/.idea/
*.kdev4

# Clang compilation database
/compile_commands.json
